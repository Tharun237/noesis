{
  "name": "noesis",
  "private": true,
  "version": "0.1.0",
  "description": "Listen to any document. Free, private, on-device text to speech.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test src/lib/*.test.js",
    "icons": "pwa-assets-generator",
    "postinstall": "node -e \"for (const d of ['wasm','cmaps','standard_fonts','iccs']) require('fs').cpSync('node_modules/pdfjs-dist/'+d, 'public/pdfjs/'+d, {recursive: true})\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.13.0",
    "motion": "^14.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
